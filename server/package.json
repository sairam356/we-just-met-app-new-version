    "@wjm/shared": "*",
    "fastify": "^4.28.1",
    "jose": "^5.9.6",
    "pg": "^8.23.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "vitest": "^2.1.5"
  }
}
